
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrooveScoreV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style",
    "meter",
    "tempo",
    "bars",
    "ticks_per_quarter",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "style": {
      "type": "string",
      "enum": ["rock", "funk", "blues", "jazz"]
    },
    "meter": {
      "type": "string",
      "enum": ["4/4", "6/8", "5/4", "7/4"]
    },
    "tempo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm", "beat_unit"],
      "properties": {
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 220
        },
        "beat_unit": {
          "type": "string",
          "enum": ["quarter", "dotted_quarter"]
        }
      }
    },
    "bars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "ticks_per_quarter": { "const": 96 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "instrument", "velocity"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "instrument": {
            "type": "string",
            "enum": [
              "kick", "snare", "closed_hat", "open_hat",
              "ride", "crash", "tom_high", "tom_mid",
              "tom_low", "rim"
            ]
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          }
        }
      }
    }
  }
}

